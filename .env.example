# =====================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Este archivo SI se sube a git: no pongas secretos reales aqui.
#
# Uso en una maquina nueva:
#   cp .env.example .env    (y rellenar los valores)
#
# Nota: el CLI de Prisma (db:push, db:migrate, db:seed, db:studio)
# solo lee .env, NO lee .env.local. Por eso todo va en .env.
#
# Cada variable indica su valor en LOCAL y en PRODUCCION (OVH-Cloud).
# =====================================================================


# --- URL publica de la aplicacion ---
# LOCAL: http://localhost:3000   (sin barra final)
# OVH:   https://tudominio.com
NEXTAUTH_URL=http://localhost:3000

# --- Base de datos PostgreSQL ---
# LOCAL: PostgreSQL instalado en la maquina
#        postgresql://postgres:PASSWORD@localhost:5432/influencer_dev
# OVH:   contenedor de Postgres; el host es el nombre del servicio
#        en docker-compose (normalmente "db"), no localhost
#        postgresql://influencer:PASSWORD@db:5432/influencer_prod
# Si la contrasena lleva @ : / ? # & % hay que codificarla en URL
DATABASE_URL=

# --- Secreto de sesion (NextAuth) ---
# Firma los JWT de sesion. DEBE ser distinto en local y en produccion.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# --- Confianza en proxy inverso ---
# Solo en OVH, si la app corre detras de Nginx / Traefik / Caddy.
# Sin esto NextAuth v5 puede construir mal las URLs de callback.
# LOCAL: dejar vacio.  OVH: true
AUTH_TRUST_HOST=

# --- Apify (scraping de metricas de Instagram y TikTok) ---
# Lo lee src/lib/apify.ts. El mismo token sirve en local y produccion.
# Sin este token la sincronizacion devuelve null y falla en silencio.
APIFY_API_TOKEN=


# --- Variables de infraestructura (solo produccion en OVH) ---
# Las consume el contenedor de PostgreSQL en docker-compose,
# no el codigo de la aplicacion. Deben coincidir con DATABASE_URL.
# POSTGRES_USER=influencer
# POSTGRES_PASSWORD=
# POSTGRES_DB=influencer_prod


# --- Aun no usadas por el codigo (funcionalidades planeadas) ---
ENABLE_EMAILS=false
RESEND_FROM_EMAIL=
RESEND_API_KEY=
ANTHROPIC_API_KEY=
