# =====================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Este archivo SI se sube a git: no pongas secretos reales aqui.
#
# Uso en una maquina nueva:
#   cp .env.example .env    (y rellenar los valores)
#
# Nota: el CLI de Prisma (db:push, db:migrate, db:seed, db:studio)
# solo lee .env, NO lee .env.local. Por eso todo va en .env.
#
# EN PRODUCCION este archivo NO se usa: las variables se cargan en el
# panel de Dokploy (servicio de la app -> Environment). El .dockerignore
# impide que cualquier .env entre en la imagen.
#
# Cada variable indica su valor en LOCAL y en PRODUCCION (OVH/Dokploy).
# =====================================================================


# --- URL publica de la aplicacion ---
# LOCAL: http://localhost:3000   (sin barra final)
# OVH:   https://influencer-manager.losdemarketing.com
# Con esta URL se construyen los enlaces de aprobacion que se mandan al
# cliente, asi que si esta mal los correos salen con enlaces rotos.
NEXTAUTH_URL=http://localhost:3000

# --- Base de datos PostgreSQL ---
# LOCAL: contenedor de docker-compose.dev.yml (pgvector, puerto 5433)
#        postgresql://postgres:devpass@localhost:5433/influencer-manager
# OVH:   URL INTERNA del servicio de Postgres en Dokploy; el host es el
#        nombre del contenedor, no localhost ni una IP publica.
# Si la contrasena lleva @ : / ? # & % hay que codificarla en URL.
# La base necesita las extensiones "vector" y "pg_trgm": las crea sola
# la primera migracion, siempre que la imagen de Postgres las traiga
# (pgvector/pgvector). Con una imagen de Postgres pelada, fallara.
DATABASE_URL=

# --- Secreto de sesion (NextAuth) ---
# Firma los JWT de sesion. DEBE ser distinto en local y en produccion.
# Si cambia, se cierran todas las sesiones abiertas.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# --- Confianza en proxy inverso ---
# YA NO HACE FALTA: src/lib/auth.config.ts fija trustHost: true, porque
# esta variable es un campo de minas. NextAuth la resuelve como
#   trustHost ??= !!(AUTH_URL ?? AUTH_TRUST_HOST ?? VERCEL ?? ...)
# o sea que mira AUTH_URL y NO NEXTAUTH_URL, y al usar ?? antes del !!
# una AUTH_TRUST_HOST declarada pero VACIA se evalua como false, igual
# que si no existiera. Se deja documentada para que nadie la reintroduzca
# creyendo que arregla algo.
# AUTH_TRUST_HOST=

# --- Apify (scraping de metricas de Instagram y TikTok) ---
# Lo lee src/lib/apify.ts. El mismo token sirve en local y produccion.
# Sin este token la sincronizacion devuelve null y falla en silencio.
APIFY_API_TOKEN=

# --- Almacenamiento de archivos subidos (EN DISCO) ---
# Guarda las fotos de perfil que descarga Apify y los adjuntos del
# formulario publico /brief. Se sirven por /api/uploads/[...ruta].
#
# NO se usa public/: con "output: standalone" Next calcula el listado
# de public/ durante el build y devuelve 404 para todo lo que se
# escriba despues.
#
# LOCAL: dejar vacio, se usa ./uploads en la raiz del proyecto.
# OVH:   /app/uploads, que es donde Dokploy monta el volumen. Ya viene
#        fijado en el Dockerfile, no hace falta repetirlo.
# UPLOADS_DIR=

# --- Almacenamiento alternativo en Vercel Blob (opcional) ---
# Si se define, las fotos de perfil van a Blob en vez de al disco. No
# hace falta desplegar en Vercel para usarlo. Dejar vacio para el
# despliegue en OVH, que usa el volumen.
BLOB_READ_WRITE_TOKEN=

# --- Correo transaccional (Resend) ---
# Los envios estan APAGADOS salvo que ENABLE_EMAILS sea exactamente
# "true". Sin RESEND_API_KEY tampoco se manda nada (solo un aviso en el
# log). RESEND_FROM_EMAIL debe ser un dominio verificado en Resend.
ENABLE_EMAILS=false
RESEND_FROM_EMAIL=
RESEND_API_KEY=

# --- Asistente de campanas con IA (Anthropic) ---
# Lo usa /api/chat/campaign. Sin esta clave el chat responde con error.
ANTHROPIC_API_KEY=

# --- Datos de ejemplo del seed ---
# Lo lee prisma/seed.ts. Con "false" se cargan solo los datos de
# catalogo (admin, plataformas, tipos de servicio, categorias, generos,
# ubicaciones y rangos de alcance) y se omiten los perfiles, clientes y
# campanas inventados. Usar SIEMPRE false en produccion.
# SEED_DEMO=false

# --- Migraciones al arrancar el contenedor ---
# Solo produccion. Lo lee docker-entrypoint.sh: por defecto aplica
# "prisma migrate deploy" en cada arranque. Poner false para arrancar
# sin tocar la base de datos.
# RUN_MIGRATIONS=true
